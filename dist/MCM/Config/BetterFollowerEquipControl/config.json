{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "BetterFollowerEquipControl",
  "displayName": "Better Follower Equip Control",
  "minMcmVersion": 13,
  "content": [
    {
      "text": "Settings",
      "type": "header"
    },
    {
      "type": "empty"
    },
    {
      "text": "Fast Transfer",
      "type": "toggle",
      "help": "If Fast Transfer hotkey should be evailable",
      "groupControl": 1,
      "valueOptions": {
        "sourceType": "GlobalValue",
        "sourceForm": "BetterFollowerEquipControl.esp|804",
        "defaultValue": 1
      }
    },
    {
      "text": "Fast Transfer Hotkey",
      "type": "keymap",
      "help": "Hotkey that can be hold while pressing on item in invetory to transfer it instantly to followers inventory without prompt",
      "groupCondition": 1,
      "ignoreConflicts": false,
      "valueOptions": {
        "sourceType": "GlobalValue",
        "sourceForm": "BetterFollowerEquipControl.esp|803",
        "defaultValue": 29
      }
    },
    {
      "text": "Persist follower",
      "type": "toggle",
      "help": "If followers outfit should be kept disabled after they are dismissed from player",
      "valueOptions": {
        "sourceType": "GlobalValue",
        "sourceForm": "BetterFollowerEquipControl.esp|805",
        "defaultValue": 1
      }
    },
    {
      "text": "Follower only [EXPERIMENTAL]",
      "type": "toggle",
      "help": "EXPERIMENTAL, USE AT OWN RISK: If only followers should be targeted by BFEC. Note that disabling this might decrease stability of the game and bring other unexpected bugs. If NPC is using LeveledList, the BFEC will have issue selecting correct items. Additionaly, if NPC dies, it will spawn additional items which are already added by BFEC (doubling them)",
      "valueOptions": {
        "sourceType": "GlobalValue",
        "sourceForm": "BetterFollowerEquipControl.esp|806",
        "defaultValue": 1
      }
    },
    {
      "text": "Race check",
      "type": "toggle",
      "help": "If only NPCs of playable races and races in RaceList can be processed",
      "valueOptions": {
        "sourceType": "GlobalValue",
        "sourceForm": "BetterFollowerEquipControl.esp|807",
        "defaultValue": 1
      }
    }
  ]
}